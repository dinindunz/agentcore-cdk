# AgentCore CDK Environment Variables
# Copy this file to .env and fill in your values
#
# NOTE: This file contains SECRETS and AWS account information.
# Environment-specific configuration (memory, runtime, observability, evaluation)
# is now managed in config/*.yaml files.

# ============================================================================
# Deployment Environment
# ============================================================================
# Specifies which environment to deploy (dev, test, prod)
# This determines which config/{ENV}.yaml file is loaded
# Stack will be named AgentCoreStack-{ENV}
ENV=dev

# ============================================================================
# AWS Configuration
# ============================================================================
# AWS Account ID where resources will be deployed
AWS_ACCOUNT_ID=your_aws_account_id

# AWS Region for deployment (default: ap-southeast-2 for Sydney)
REGION_NAME=ap-southeast-2

# ============================================================================
# External Service Credentials
# ============================================================================
# GitHub Personal Access Token (required for GitHub MCP server)
# Create at: https://github.com/settings/tokens
# Required scopes: repo, read:org
GITHUB_TOKEN=your_github_token_here

# ============================================================================
# Agent Runtime Configuration (Optional)
# ============================================================================
# Actor ID - Unique identifier for memory personalisation across sessions
# If not set, a random ID is generated each time you run the agent
# Set this to maintain the same identity across multiple chat sessions
ACTOR_ID=my-user-id