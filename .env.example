# AgentCore CDK Configuration
# Copy this file to .env and fill in your values

# AWS Configuration
AWS_ACCOUNT_ID=your_aws_account_id
REGION_NAME=ap-southeast-2

# GitHub Personal Access Token (required for GitHub MCP server)
GITHUB_TOKEN=your_github_token_here

# Actor ID (optional) - Unique identifier for memory personalisation across sessions
# If not set, a random ID is generated each time you run the agent
# Set this to maintain the same identity across multiple chat sessions for cross-session learning
# ACTOR_ID=my-user-id